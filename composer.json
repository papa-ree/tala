{
    "name": "bale/tala",
    "description": "Autentikasi SSO Keycloak dan panel warga global untuk Bale",
    "keywords": [
        "bale",
        "laravel",
        "panel",
        "sso",
        "keycloak",
        "tala"
    ],
    "homepage": "https://github.com/papa-ree/tala",
    "license": "MIT",
    "authors": [
        {
            "name": "Ricky Romdhoni",
            "email": "ricky.romdhoni@gmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.2",
        "bale/umpak": "*",
        "laravel/socialite": "^5.31",
        "livewire/livewire": "^4.0",
        "socialiteproviders/keycloak": "^5.3"
    },
    "autoload": {
        "psr-4": {
            "Bale\\Tala\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Bale\\Tala\\TalaServiceProvider"
            ]
        }
    }
